<?xml version="1.0" encoding="utf-8"?>
<!--
  VietKB, Microsoft Store (MSIX) package manifest. scripts/build-store.ps1
  copies this next to vietkb.exe, replaces __VERSION__ and runs makeappx.

  Identity comes from Partner Center (Store ID 9N5TNMLCZNT5); do not edit it
  by hand. The Store re-signs the package, so the submission is unsigned.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="40278Noamo.VietKB"
    Publisher="CN=FE739770-637C-437D-B2B9-DAA2E2EA56F1"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>VietKB</DisplayName>
    <PublisherDisplayName>Noamo</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="vi-VN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="vietkb.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="VietKB"
        Description="Bộ gõ tiếng Việt nhanh, nhẹ, dễ cấu hình."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Autostart. Disabled until the user (or the app, asking) turns it on;
             the app drives it through Windows.ApplicationModel.StartupTask. -->
        <uap5:Extension Category="windows.startupTask" Executable="vietkb.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="VietKBStartup" Enabled="false" DisplayName="VietKB" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
