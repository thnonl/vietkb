<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Menu-bar extra only: no Dock icon, not even a flash at launch. The app
	     also sets ActivationPolicy::Accessory at runtime. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Launch Services (Finder, Spotlight, `open`) activates the running copy of
	     this bundle id instead of starting another; `open -n` and a direct exec
	     still reach the single-instance plugin and the lock in singleton.rs. -->
	<key>LSMultipleInstancesProhibited</key>
	<true/>
</dict>
</plist>
