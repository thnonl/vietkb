{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VietKB",
  "version": "0.1.1",
  "identifier": "dev.vietkb.app",
  "build": {
    "frontendDist": "dist"
  },
  "bundle": {
    "icon": ["icons/icon-logo.ico"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VietKB x64 - Bộ gõ tiếng Việt",
